{
  "name": "scanitprintit-agent",
  "version": "1.1.9",
  "description": "ScanItPrintIt Shop Owner Dashboard & Print Agent",
  "main": "src/main/index.js",
  "author": "ScanItPrintIt",
  "license": "ISC",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder --win --x64",
    "pack": "electron-builder --dir",
    "test": "node --test tests/*.test.cjs",
    "test:render": "electron tests/render-smoke.cjs"
  },
  "dependencies": {
    "electron-store": "^7.0.2",
    "electron-updater": "^6.3.9",
    "node-fetch": "^2.7.0",
    "pdfjs-dist": "4.10.38",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "in.scanitprintit.agent.v2",
    "productName": "ScanItPrintIt Agent",
    "copyright": "Copyright © 2026 ScanItPrintIt",
    "electronLanguages": [
      "en-US"
    ],
    "extraResources": [
      {
        "from": "build/graceful-upgrade.json",
        "to": "graceful-upgrade.json"
      }
    ],
    "publish": {
      "provider": "generic",
      "url": "https://www.scanitprintit.in/updates/"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    },
    "files": [
      "src/**/*",
      "resources/**/*"
    ]
  }
}
